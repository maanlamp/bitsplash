{
	"name": "bitsplash",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun i --frozen-lockfile && concurrently -k -n vite,app \"vite\" \"electron src/desktop/main.cjs\"",
		"game": "bun i --frozen-lockfile && vite build && electron src/desktop/game.cjs",
		"perf": "node scripts/perf-dev-startup.ts",
		"gen": "bun run scripts/gen-ink.ts && bun run scripts/gen-bubble-sprite.ts && bun run scripts/gen-emotion-icons.ts && bun run scripts/gen-assets.ts",
		"build": "bun run gen && tsc -b && vite build",
		"preview": "vite preview",
		"check": "bun run gen && bun oxlint --fix && bun oxfmt && bun tsc -b && bun test",
		"pretest": "bun run gen"
	},
	"dependencies": {
		"@base-ui/react": "1.5.0",
		"@dimforge/rapier2d": "0.19.3",
		"@number-flow/react": "0.6.0",
		"@phosphor-icons/react": "2.1.10",
		"@types/bun": "1.3.14",
		"clsx": "2.1.1",
		"colorjs.io": "0.6.1",
		"electron": "42.4.1",
		"fflate": "0.8.3",
		"inkjs": "2.4.0",
		"motion": "12.40.0",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"rbush": "4.0.1",
		"react": "19.2.6",
		"react-aria-components": "1.18.0",
		"react-dom": "19.2.6",
		"react-hotkeys-hook": "5.3.2",
		"react-inspector": "9",
		"react-reconciler": "0.33.0",
		"sass-embedded": "1.100.0",
		"text-shaper": "0.1.22",
		"the-new-css-reset": "1.11.3",
		"yoga-layout": "3.2.1"
	},
	"devDependencies": {
		"@dimforge/rapier2d-compat": "0.19.3",
		"@types/node": "24.12.3",
		"@types/rbush": "4.0.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/react-reconciler": "0.33.0",
		"@vitejs/plugin-react": "6.1.1",
		"concurrently": "10.0.3",
		"globals": "17.6.0",
		"magic-string": "1.2.3",
		"oxc-parser": "0.147.0",
		"oxc-transform-react": "0.147.0",
		"oxlint-tsgolint": "7.0.2001",
		"playwright": "1.62.1",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vite-plugin-mkcert": "2.1.0"
	}
}
